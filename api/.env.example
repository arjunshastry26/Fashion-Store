# MongoDB Connection
# Replace with your MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/fashion-store
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/fashion-store
DB_URL=mongodb://localhost:27017/fashion-store

# Server Port (optional, defaults to 5000)
PORT=5000

# JWT Secret Key
# Generate a secure random string for production
JWT_SECRET=your-secret-jwt-key-change-this-in-production

# Stripe Secret Key
# Get this from your Stripe dashboard at https://dashboard.stripe.com/apikeys
STRIPE_SECRET=your-stripe-secret-key
